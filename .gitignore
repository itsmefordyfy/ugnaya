# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Server-only secrets (API keys for Expo API routes); never commit
.env
# Sentry auth token for source map uploads (never commit)
.env.sentry-build-plugin

# Android upload keys live outside the repo (~/keys); never commit one
*.keystore

# Business plan and other owner documents (not in git)
/documents/

# Local Expo modules: Gradle builds them in place
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Python bytecode (render scripts)
__pycache__/

# Next.js
.next/
out/
.vercel
next-env.d.ts

# Supabase CLI state
supabase/.temp/
supabase/.branches/

# Deno
.deno/

# superpowers plan workspaces
.superpowers/
!.env.example
