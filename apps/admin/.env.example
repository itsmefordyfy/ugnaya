# Copy to .env.local. All values are public (they reach the browser); the admin app holds NO secret key.
NEXT_PUBLIC_SUPABASE_URL=https://ohicvyappmccynchzukg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where each UGNAYA app lives. Leave blank in development (3000 / 3001 / 3002); set them for staging and production.
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MERCHANT_URL=
NEXT_PUBLIC_ADMIN_URL=
# Optional extra layer: only these addresses can reach the portal (comma-separated IPs or IPv4 ranges like 203.0.113.0/24).
# Empty = no restriction. Not a substitute for sign-in, MFA and database permissions.
ADMIN_ALLOWED_IPS=
