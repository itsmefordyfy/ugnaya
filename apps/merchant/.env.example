# Copy to .env.local and fill in from Supabase (Project Settings → API keys). All values are public; never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://ohicvyappmccynchzukg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where each UGNAYA app lives. Leave blank in development (marketing 3000, app 3001, admin 3002, merchant 3003); set them for staging and production.
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MERCHANT_URL=
NEXT_PUBLIC_ADMIN_URL=
# Show "Continue with Google" once the Google client is set up in Supabase (docs/SUPABASE_SETUP.md, step 4).
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
