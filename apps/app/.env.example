# Copy to .env.local and fill in from Supabase (Project Settings → API keys). All values are public.
NEXT_PUBLIC_SUPABASE_URL=https://ohicvyappmccynchzukg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where each UGNAYA app lives. Leave blank in development (3000 / 3001 / 3002); set them for staging and production.
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MERCHANT_URL=
NEXT_PUBLIC_ADMIN_URL=
# Show "Continue with Google" once the Google client is set up in Supabase (docs/SUPABASE_SETUP.md, step 4).
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
